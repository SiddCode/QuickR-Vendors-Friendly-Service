# QuickR Environment Variables Configuration Example
PORT=53211
MONGODB_URI=mongodb://localhost:27017/quickr
JWT_SECRET=quickr_super_secret_jwt_key_987654321_production_grade_security
FRONTEND_URL=http://localhost:5173

# Optional: Public Registration Switch (default: false)
ALLOW_PUBLIC_REGISTRATION=false

# Production Groq Cloud AI Engine Configuration (Recommended for Production Deployment)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# Local Ollama AI Engine Configuration (Fallback for Local Development)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# WhatsApp Business Cloud API Configuration (Leave blank for Development/Mock mode)
WHATSAPP_API_VERSION=v19.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
